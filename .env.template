# Azure OpenAI Configuration
# Get these values from Azure Portal > Azure OpenAI resource
# IMPORTANT: Use resource-specific endpoint, NOT regional endpoint
# ✅ Correct:   https://your-resource-name.openai.azure.com/
# ❌ Incorrect: https://eastus.api.cognitive.microsoft.com/
# Regional endpoints may cause model routing issues with the Python SDK
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_KEY=your-api-key-here
AZURE_OPENAI_DALLE_DEPLOYMENT_NAME=dall-e-3
AZURE_OPENAI_GPT_DEPLOYMENT_NAME=gpt-4o

# Azure Content Safety Configuration
# Get these values from Azure Portal > Content Safety resource
AZURE_CONTENT_SAFETY_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_CONTENT_SAFETY_KEY=your-api-key-here

# Optional: Custom blocklist name (create in Azure Content Safety portal)
AZURE_CONTENT_SAFETY_BLOCKLIST_NAME=prohibited-advertising-terms

# Azure Translator Configuration (Optional - for multi-language campaigns)
# Get these values from Azure Portal > Translator resource
# If not configured, campaign messages will remain in original language
AZURE_TRANSLATOR_KEY=your-translator-key-here
AZURE_TRANSLATOR_REGION=eastus
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Optional: Logging Configuration
LOG_LEVEL=INFO
